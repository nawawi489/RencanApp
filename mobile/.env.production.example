# =========================================================================
# .env.production.example — TEMPLATE untuk `.env.production`
# =========================================================================
# File ini dipakai HANYA untuk verifikasi terakhir (smoke test) dev server
# yang menembak SUPABASE PRODUCTION dari mesin lokal.
# JANGAN dipakai untuk pengembangan sehari-hari.
#
# Cara pakai:
#   cp .env.production.example .env.production
#   npx expo start --env-file .env.production
#
# `.env.production` di-gitignore. Untuk BUILD EAS production (channel `production`),
# nilai di-inject dari `eas.json` (env block) atau EAS Environment Variables.
# =========================================================================

# Ambil dari Supabase Dashboard → Project (production) → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<prod-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<prod-anon-key>

EXPO_PUBLIC_APP_ENV=production

# S2-7: Universal Link host. Wajib https:// dan cocok dengan
# associatedDomains di app.json + AASA/assetlinks yang dipublish di
# /.well-known/ domain ini.
EXPO_PUBLIC_APP_LINK_HOST=https://rencanapp.com

# DSN proyek Sentry PRODUCTION.
# EXPO_PUBLIC_SENTRY_DSN=https://<publicKey>@o<orgId>.ingest.sentry.io/<prod-projectId>
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# EXPO_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0
