{
  "expo": {
    "name": "Rencanapp",
    "slug": "ems",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/198a4371-d0ca-4598-9628-619a24d97d43",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ems",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rencanapp.mobile",
      "icon": "./assets/expo.icon",
      "associatedDomains": [
        "applinks:staging.rencanapp.com",
        "applinks:rencanapp.com"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Rencanapp membutuhkan akses foto untuk melampirkan bukti pelaksanaan Task, submission, dan lampiran chat.",
        "NSCameraUsageDescription": "Rencanapp membutuhkan akses kamera untuk mengambil foto bukti pelaksanaan Task dan lampiran chat langsung dari kamera.",
        "NSMicrophoneUsageDescription": "Rencanapp membutuhkan akses mikrofon untuk merekam video bukti pelaksanaan Task dan lampiran chat berupa video.",
        "NSPhotoLibraryAddUsageDescription": "Rencanapp perlu menyimpan gambar yang Anda unduh dari chat atau lampiran Task ke galeri.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rencanapp.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "staging.rencanapp.com", "pathPrefix": "/reset-password" },
            { "scheme": "https", "host": "rencanapp.com",         "pathPrefix": "/reset-password" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#208aef",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rencanapp membutuhkan akses foto untuk melampirkan bukti pelaksanaan Task, submission, dan lampiran chat.",
          "cameraPermission": "Rencanapp membutuhkan akses kamera untuk mengambil foto bukti pelaksanaan Task dan lampiran chat langsung dari kamera.",
          "microphonePermission": "Rencanapp membutuhkan akses mikrofon untuk merekam video bukti pelaksanaan Task dan lampiran chat berupa video."
        }
      ],
      "expo-document-picker",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "198a4371-d0ca-4598-9628-619a24d97d43"
      }
    },
    "owner": "nww489"
  }
}
