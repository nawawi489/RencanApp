# =========================================================================
# .env.staging.example — TEMPLATE untuk `.env.staging`
# =========================================================================
# File ini dipakai kalau Anda ingin menjalankan dev server (npm run web/ios/android)
# yang menembak SUPABASE STAGING remote dari mesin lokal.
#
# Cara pakai:
#   cp .env.staging.example .env.staging
#   npx expo start --env-file .env.staging
#
# `.env.staging` di-gitignore. Untuk BUILD EAS staging (channel `preview`),
# nilai di-inject dari `eas.json` (env block) — bukan dari file ini.
# =========================================================================

# Ambil dari Supabase Dashboard → Project (staging) → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<staging-anon-key>

EXPO_PUBLIC_APP_ENV=staging

# S2-7: Universal Link host. Wajib https:// dan cocok dengan
# associatedDomains di app.json + AASA/assetlinks yang dipublish di
# /.well-known/ domain ini. Lihat docs/well-known/README.md.
EXPO_PUBLIC_APP_LINK_HOST=https://staging.rencanapp.com

# DSN proyek Sentry STAGING (proyek terpisah dari production agar noise tak campur).
# EXPO_PUBLIC_SENTRY_DSN=https://<publicKey>@o<orgId>.ingest.sentry.io/<staging-projectId>
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.5
# EXPO_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0
