# Salin file ini menjadi .env lalu isi nilainya.
# Nilai EXPO_PUBLIC_* di-bundle ke klien — gunakan publishable/anon key, BUKAN service_role key.
#
# --- Dev lokal (Supabase CLI) ---
# Pakai host `localhost` (BUKAN 127.0.0.1) agar web preview di localhost:8081
# tidak nge-abort cross-origin. Helper resolveSupabaseUrl() akan menormalkan
# otomatis per Platform.OS:
#   web    → localhost:54321
#   iOS sim → 127.0.0.1:54321 (canonical simulator host)
#   Android emu → 10.0.2.2:54321 (host machine alias)
# Host non-local (staging/prod/LAN IP/host.docker.internal) TIDAK dimutasi.
#
# EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
#
# --- Staging/Prod ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Sentry (telemetry) ---
# DSN: kosongkan di dev lokal → initSentry return null (Sentry off, aman).
# Isi di staging/prod (buat proyek terpisah per environment agar noise dev tak mencampur prod).
# EXPO_PUBLIC_SENTRY_DSN=https://<publicKey>@o<orgId>.ingest.sentry.io/<projectId>
#
# Environment tag di dashboard Sentry. Default: __DEV__ → 'development', selain itu 'production'.
# Set eksplisit di EAS untuk membedakan preview vs production.
# EXPO_PUBLIC_APP_ENV=production
#
# Sampling rate — kosongkan untuk default (dev 1.0 / prod 0.1 traces & 0 profiles).
# Kalau tersetel tapi tidak valid ([0,1]), fallback ke default (startup tidak crash).
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# EXPO_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0
