# =========================================================================
# .env.example — TEMPLATE untuk `.env` (dev lokal, Supabase CLI + docker)
# =========================================================================
# Cara pakai:
#   cp .env.example .env
# File `.env` di-gitignore.
#
# Untuk build staging/production: TIDAK memakai file ini. Nilai di-inject via
# `eas.json` (env block) atau EAS Environment Variables. Lihat .env.staging.example
# / .env.production.example bila ingin menjalankan dev server yang menembak
# Supabase remote dari mesin lokal.
# =========================================================================

# --- Supabase (Local Supabase CLI / docker) ---
# Pakai host `localhost` (BUKAN 127.0.0.1) agar web preview di localhost:8081
# tidak nge-abort cross-origin. Helper resolveSupabaseUrl() akan menormalkan
# otomatis per Platform.OS:
#   web        → localhost:54321
#   iOS sim    → 127.0.0.1:54321 (canonical simulator host)
#   Android emu→ 10.0.2.2:54321 (host machine alias)
# Host non-local (staging/prod/LAN IP/host.docker.internal) TIDAK dimutasi.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- App env tag ---
# Tag environment untuk logger/Sentry. Nilai umum: development | staging | production.
# Kalau kosong, initSentry fallback ke __DEV__ ? 'development' : 'production'.
EXPO_PUBLIC_APP_ENV=development

# --- Universal Links / App Links host (S2-7) ---
# Origin HTTPS terverifikasi (AASA + assetlinks.json terbit di /.well-known/)
# yang dipakai sebagai `redirectTo` untuk reset password. Wajib https://.
# Dev lokal boleh kosong — login.tsx fallback ke ems://reset-password.
# EXPO_PUBLIC_APP_LINK_HOST=

# --- Sentry (opsional di dev lokal) ---
# Kosongkan di dev lokal → initSentry return null (Sentry off, aman).
# Isi hanya jika ingin verifikasi wiring Sentry dari mesin dev.
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# EXPO_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=
